# Optional. Leave unset to omit the meta tag; DNS domain verification can be used instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Enables the existing App Store tap event. Never commit the real token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional expanded website analytics. Keep unset until the privacy gates in docs/seo-strategy.md pass.
NEXT_PUBLIC_POSTHOG_WEB_ANALYTICS_ENABLED=
